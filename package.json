{
  "name": "@observe/browser-rum",
  "version": "0.1.0",
  "description": "Observe Browser RUM - OpenTelemetry-based real user monitoring for web applications",
  "main": "./dist/observe-brum.js",
  "files": [
    "dist/observe-brum.js"
  ],
  "scripts": {
    "build": "./build.sh",
    "build:dev": "./build.sh --dev",
    "test": "./test.sh",
    "test:coverage": "./test.sh --coverage",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "deps:check": "npm-check-updates",
    "deps:otel": "npm-check-updates '@opentelemetry/*' -u && npm install",
    "deps:doctor": "npm-check-updates -u --doctor"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-web": "^0.70.1",
    "@opentelemetry/browser-instrumentation": "^0.12.1",
    "@opentelemetry/context-zone": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-user-interaction": "^0.69.1",
    "@opentelemetry/opentelemetry-browser-detector": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "web-vitals": "^6.2.3",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "npm-check-updates": "^23.1.1"
  },
  "overrides": {
    "@opentelemetry/semantic-conventions": "$@opentelemetry/semantic-conventions",
    "@opentelemetry/api": "^1.10.0"
  }
}
